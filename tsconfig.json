{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@app/*": ["./slices/app/*"],
			"@shared/*": ["./slices/shared/*"],
			"@entities/*": ["./slices/entities/*"],
			"@pages/*": ["./slices/pages/*"],
			"@widgets/*": ["./slices/widgets/*"],
			"@features/*": ["./slices/features/*"],
			"@modules/*": ["./slices/modules/*"],
			"@assets/*": ["./assets/*"],
			"@expo-modules/*": ["./modules/*"]
		}
	},
	"include": [
		"*.ts",
		"slices/**/*.ts",
		"slices/**/*.tsx",
		"app/**/*.ts",
		"app/**/*.tsx",
		"modules/**/*.ts",
		"modules/**/*.tsx",
		"assets/**/*.ts",
		"cli/**/*.ts",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"declarations/**/*.d.ts"
	],
	"exclude": [
		"**/node_modules",
		".claude",
		"android",
		"ios",
		"target",
		"e2e"
	]
}
