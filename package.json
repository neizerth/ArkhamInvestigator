{
	"name": "arkham-investigator",
	"main": "expo-router/entry",
	"version": "2.18.0",
	"scripts": {
		"start": "expo start",
		"reset-project": "node ./scripts/reset-project.js",
		"a": "npm run prebuild:android:dev && npm run android",
		"a:p": "npm run prebuild:android",
		"a:pd": "npm run prebuild:android:dev",
		"i": "npm run ios",
		"i2": "sh ./cli/run-dual-ios.sh",
		"i:d": "npm run ios:device",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"ios:device": "expo run:ios --device",
		"web": "expo start --web",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"expo:lint": "expo lint",
		"circular": "npx madge --circular slices/",
		"t": "npm run ts:check",
		"ts:check": "tsc",
		"f": "npm run format",
		"lint": "npx @biomejs/biome check ./slices ./modules",
		"format": "npx @biomejs/biome check --write ./slices ./modules",
		"lint:fix": "npx @biomejs/biome lint --write ./slices ./modules",
		"prebuild": "expo prebuild",
		"prebuild:android:dev": "MODE=development npm run prebuild -- -p android",
		"prebuild:android": "npm run prebuild -- -p android",
		"prebuild:ios": "npm run prebuild -- -p ios",
		"eas:android": "npm run version:increment && npm run prebuild:android && eas build -p android",
		"eas:rustore": "npm run eas:android -- --profile rustore",
		"build:modules": "./modules/build.sh",
		"build": "npm run build:android && npm run build:ios",
		"build:rustore": "npm run eas:rustore -- --local --clear-cache",
		"build:android": "npm run eas:android -- --local --clear-cache",
		"deploy:android": "npm run build:android && npm run submit:android",
		"deploy:ios": "npm run build:ios && npm run submit:ios",
		"deploy:rustore": "npm run build:rustore && npm run submit:rustore",
		"build:ios": "npm run prebuild:ios && eas build -p ios --local --clear-cache --non-interactive",
		"postbuild:ios": "tsx ./cli/rename-build.ts ipa",
		"postbuild:android": "tsx ./cli/rename-build.ts aab",
		"postbuild:rustore": "tsx ./cli/rename-build.ts apk",
		"submit": "npm run submit:android && npm run submit:ios",
		"submit:ios": "sh ./cli/submit.sh ios ipa",
		"submit:android": "sh ./cli/submit.sh android aab",
		"submit:rustore": "sh ./cli/submit-rustore.sh",
		"setup:font": "tsx ./cli/update-icon-font.ts",
		"setup": "npm run setup:font",
		"version:increment": "tsx ./cli/increment-version.ts",
		"gradle:clean": "cd android && ./gradlew clean",
		"gradle:clean-cache": "rm -rf android/app/build android/.gradle modules/chaos-odds/android/.cxx modules/chaos-odds/android/build/intermediates/cxx",
		"gradle:clean-modules": "rm -rf modules/*/android/.cxx modules/*/android/build/intermediates/cxx",
		"expo:clear": "expo start -c",
		"pod:install": "cd ios && pod install",
		"postinstall": "patch-package",
		"e2e": "MAESTRO_CLI_NO_ANALYTICS=1 MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED=true maestro --platform android ${E2E_DEVICE:+--device $E2E_DEVICE} test -e APP_ID=${APP_ID:-com.arkhaminvestigator.dev} e2e"
	},
	"jest": {
		"preset": "jest-expo",
		"resolver": "react-native-worklets/jest/resolver",
		"setupFiles": ["<rootDir>/jest.setup.ts"],
		"setupFilesAfterEnv": ["<rootDir>/jest.setupAfterEnv.ts"],
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/e2e/",
			"/.claude/worktrees/"
		],
		"transformIgnorePatterns": [
			"node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-native-svg|redux-toolkit-helpers|react-redux|mime/|standard-navigation)"
		],
		"moduleNameMapper": {
			"^uuid$": "<rootDir>/node_modules/uuid/dist/cjs/index.js",
			"^slices/(.*)$": "<rootDir>/slices/$1"
		}
	},
	"dependencies": {
		"@fanchenbao/react-native-scroll-indicator": "^0.4.0",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/netinfo": "12.0.1",
		"@react-native-community/slider": "5.2.0",
		"@reduxjs/toolkit": "^2.5.1",
		"arkham-divider-data": "^1.1.14",
		"arkham-investigator-data": "^2.0.6",
		"axios": "^1.11.0",
		"domelementtype": "^2.3.0",
		"dotenv": "^17.2.1",
		"expo": "~57.0.25",
		"expo-application": "~57.0.3",
		"expo-asset": "~57.0.18",
		"expo-audio": "~57.0.5",
		"expo-blur": "~57.0.3",
		"expo-build-properties": "~57.0.22",
		"expo-clipboard": "~57.0.2",
		"expo-constants": "~57.0.19",
		"expo-file-system": "~57.0.7",
		"expo-font": "~57.0.4",
		"expo-haptics": "~57.0.3",
		"expo-image": "~57.0.5",
		"expo-image-manipulator": "~57.0.20",
		"expo-keep-awake": "~57.0.2",
		"expo-linking": "~57.0.11",
		"expo-navigation-bar": "~57.0.2",
		"expo-router": "~57.0.23",
		"expo-screen-orientation": "~57.0.2",
		"expo-sharing": "~57.0.22",
		"expo-splash-screen": "~57.0.9",
		"expo-status-bar": "~57.0.1",
		"expo-system-ui": "~57.0.4",
		"expo-web-browser": "~57.0.3",
		"fast-memoize": "^2.5.2",
		"fast-shuffle": "^6.1.1",
		"html-dom-parser": "^5.1.1",
		"html-react-parser": "^5.2.2",
		"i18next": "^25.2.1",
		"intl-pluralrules": "^2.0.1",
		"mathjs": "^14.3.0",
		"mime": "^4.1.0",
		"mime-db": "^1.54.0",
		"moment": "^2.30.1",
		"parse-url": "^10.0.3",
		"petrovich": "^0.2.1",
		"ramda": "^0.30.1",
		"ramda-adjunct": "^5.1.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-i18next": "^15.4.1",
		"react-native": "0.86.3",
		"react-native-edge-to-edge": "^1.8.2",
		"react-native-element-dropdown": "^2.12.4",
		"react-native-error-boundary": "^2.0.0",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-get-random-values": "^1.11.0",
		"react-native-gradients": "^2.1.1",
		"react-native-haptic-feedback": "^2.3.3",
		"react-native-localize": "^3.4.1",
		"react-native-logs": "^5.6.0",
		"react-native-mask-input": "^1.2.3",
		"react-native-navigation-mode": "^1.2.3",
		"react-native-qrcode-svg": "^6.3.21",
		"react-native-reanimated": "4.5.1",
		"react-native-restart": "^0.0.27",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-storage": "^1.0.1",
		"react-native-svg": "15.15.4",
		"react-native-tcp-socket": "^6.4.1",
		"react-native-toast-message": "^2.3.3",
		"react-native-web": "^0.21.0",
		"react-native-webview": "13.16.1",
		"react-native-worklets": "0.10.1",
		"react-native-zeroconf": "^0.14.0",
		"react-native-zip-archive": "^7.0.2",
		"react-redux": "^9.2.0",
		"react-responsive": "^10.0.0",
		"redux-devtools-expo-dev-plugin": "^2.0.0",
		"redux-persist": "^6.0.0",
		"redux-saga": "^1.3.0",
		"redux-toolkit-helpers": "^1.0.3",
		"semver": "^7.7.1",
		"stream": "^0.0.3",
		"styled-components": "^6.1.15",
		"uuid": "^11.0.5"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@biomejs/biome": "1.9.4",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.8.0",
		"@expo/config-plugins": "~57.0.9",
		"@jest/test-sequencer": "^30.2.0",
		"@react-native-community/cli": "^20.0.2",
		"@react-native/jest-preset": "^0.86.3",
		"@testing-library/react-native": "^14.0.1",
		"@types/color": "^4.2.0",
		"@types/fast-shuffle": "^4.5.3",
		"@types/jest": "^29.5.12",
		"@types/moment": "^2.11.29",
		"@types/ramda": "^0.30.2",
		"@types/react": "~19.2.4",
		"@types/react-native-zeroconf": "^0.13.1",
		"@types/react-test-renderer": "^19.0.0",
		"@types/semver": "^7.7.0",
		"baseline-browser-mapping": "^2.9.7",
		"jest": "^29.2.1",
		"jest-expo": "~57.0.5",
		"knip": "^5.63.1",
		"lefthook": "^1.11.3",
		"patch-package": "^8.0.1",
		"react-native-svg-transformer": "^1.5.0",
		"react-test-renderer": "19.0.0",
		"test-renderer": "^1.3.0",
		"tsx": "^4.20.3",
		"typescript": "~6.0.3"
	},
	"private": true,
	"commitlint": {
		"extends": ["@commitlint/config-conventional"]
	},
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false,
				"exclude": [
					"react-native-restart",
					"react-native-tcp-socket",
					"react-native-zip-archive",
					"redux-persist"
				]
			},
			"checkGlobalPackageManagerConfig": {
				"disabled": true
			}
		}
	},
	"optionalDependencies": {
		"bufferutil": "^4.1.0"
	}
}
