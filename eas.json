{
	"cli": {
		"version": ">= 15.0.15",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"distribution": "internal"
		},
		"production": {
			"env": {
				"EXPO_PUBLIC_ANDROID_STORE": "google-play"
			},
			"ios": {
				"credentialsSource": "remote"
			}
		},
		"rustore": {
			"env": {
				"EXPO_PUBLIC_ANDROID_STORE": "rustore"
			},
			"android": {
				"buildType": "apk"
			}
		}
	},
	"submit": {
		"production": {
			"ios": {
				"ascAppId": "6753330970"
			}
		}
	}
}
