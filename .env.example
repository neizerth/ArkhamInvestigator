# .env.local (gitignored) — submit credentials
# EXPO_APPLE_ID="your-apple-id@example.com"
# EXPO_APPLE_TEAM_ID="XXXXXXXXXX"
#
# RuStore Public API — `npm run submit:rustore`
# Create a key in RuStore Console → API keys, then either:
# RUSTORE_KEY_ID="1234567"
# RUSTORE_PRIVATE_KEY_PATH="/absolute/path/to/rustore-private.pem"
# # or paste PEM (use \n for newlines):
# # RUSTORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# # Optional:
# # RUSTORE_PUBLISH_TYPE="MANUAL"   # MANUAL | INSTANTLY | DELAYED
# # RUSTORE_WHATS_NEW="Release notes"
